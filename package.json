{
  "name": "tokeniser",
  "displayName": "Tokeniser",
  "description": "Gör användningen av Claude Code synlig – bara från dokumenterade, lokala källor.",
  "version": "0.0.1",
  "private": true,
  "publisher": "lullo",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.137.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Tokeniser",
      "properties": {
        "tokeniser.statusBar.mode": {
          "type": "string",
          "enum": ["both", "fiveHour", "week", "nearest", "context"],
          "enumDescriptions": [
            "5-timmarsgränsen och veckogränsen",
            "Bara 5-timmarsgränsen",
            "Bara veckogränsen",
            "Den gräns som har förbrukat mest",
            "Kontexten i sessionen för fönstrets projekt"
          ],
          "default": "both",
          "description": "Vad Tokeniser visar i statusraden. Värdena är alltid förbrukat, inte kvar."
        },
        "tokeniser.statusBar.warningAt": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 80,
          "description": "Procent förbrukat där statusraden får varningsfärg."
        },
        "tokeniser.statusBar.errorAt": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 95,
          "description": "Procent förbrukat där statusraden får felfärg."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test 'test/unit/**/*.test.ts'",
    "test:e2e": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test 'test/e2e/**/*.test.ts'",
    "test": "npm run test:unit && npm run test:e2e",
    "index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/index.ts",
    "connect": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/connect.ts",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/vscode": "^1.137.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
