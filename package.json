{
  "name": "tokeniser",
  "displayName": "Tokeniser",
  "description": "Gör användningen av Claude Code synlig – bara från dokumenterade, lokala källor.",
  "version": "0.0.1",
  "private": true,
  "publisher": "lullo",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.137.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {},
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/vscode": "^1.137.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
