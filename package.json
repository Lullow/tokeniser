{
  "name": "tokeniser",
  "displayName": "Tokeniser",
  "description": "Gör användningen av Claude Code synlig – bara från dokumenterade, lokala källor.",
  "version": "0.0.1",
  "private": true,
  "publisher": "lullo",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lullow/tokeniser.git"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "tokeniser",
          "title": "Tokeniser",
          "icon": "media/tokeniser.svg"
        }
      ]
    },
    "views": {
      "tokeniser": [
        {
          "type": "webview",
          "id": "tokeniser.view",
          "name": "Tokeniser"
        }
      ]
    },
    "commands": [
      {
        "command": "tokeniser.openView",
        "title": "Öppna vyn",
        "category": "Tokeniser"
      },
      {
        "command": "tokeniser.toggleView",
        "title": "Visa eller dölj vyn",
        "category": "Tokeniser"
      },
      {
        "command": "tokeniser.exportData",
        "title": "Exportera insamlad data",
        "category": "Tokeniser"
      },
      {
        "command": "tokeniser.deleteData",
        "title": "Radera insamlad data",
        "category": "Tokeniser"
      },
      {
        "command": "tokeniser.openSettings",
        "title": "Öppna inställningar",
        "category": "Tokeniser"
      }
    ],
    "configuration": {
      "title": "Tokeniser",
      "properties": {
        "tokeniser.statusBar.mode": {
          "type": "string",
          "enum": [
            "both",
            "fiveHour",
            "week",
            "nearest",
            "context"
          ],
          "enumDescriptions": [
            "5-timmarsgränsen och veckogränsen",
            "Bara 5-timmarsgränsen",
            "Bara veckogränsen",
            "Den gräns som har förbrukat mest",
            "Kontexten i sessionen för fönstrets projekt"
          ],
          "default": "both",
          "description": "Vad Tokeniser visar i statusraden. Värdena är alltid förbrukat, inte kvar."
        },
        "tokeniser.statusBar.warningAt": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 80,
          "description": "Procent förbrukat där statusraden får varningsfärg."
        },
        "tokeniser.statusBar.errorAt": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 95,
          "description": "Procent förbrukat där statusraden får felfärg."
        },
        "tokeniser.suggestions.contextPercent": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 60,
          "description": "Förslaget om stor kontext visas när kontexten passerar den här andelen av fönstret, eller antalet tokens nedan, det som kommer först."
        },
        "tokeniser.suggestions.contextTokens": {
          "type": "number",
          "minimum": 1000,
          "maximum": 10000000,
          "default": 200000,
          "description": "Förslaget om stor kontext visas när kontexten passerar så här många tokens, eller andelen ovan, det som kommer först."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/view/webview",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test 'test/unit/**/*.test.ts'",
    "test:e2e": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test 'test/e2e/**/*.test.ts'",
    "test": "npm run test:unit && npm run test:e2e",
    "test:integration": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/integration.ts",
    "index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/index.ts",
    "connect": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/connect.ts",
    "package": "vsce package --no-dependencies --skip-license --out tokeniser.vsix",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/vscode": "^1.137.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
